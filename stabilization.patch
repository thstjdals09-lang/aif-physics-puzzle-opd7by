diff --git a/index.html b/index.html
new file mode 100644
--- /dev/null
+++ b/index.html
@@
+<!doctype html>
+<html lang="ko">
+<head>
+  <meta charset="utf-8">
+  <title>스타 카운터</title>
+  <style>
+    /* 기본 레이아웃 및 반응형 디자인 */
+    html, body { margin:0; padding:0; height:100%; overflow:hidden; background:#0a0a1a; color:#fff; font-family:Arial,Helvetica,sans-serif; }
+    #ui { position:absolute; top:0; left:0; width:100%; padding:10px; box-sizing:border-box; display:flex; justify-content:space-between; align-items:center; }
+    #score { font-size:1.2rem; }
+    #msg { font-size:1.5rem; margin-top:10px; text-align:center; }
+    #restartBtn { padding:5px 10px; background:#0066ff; border:none; color:#fff; border-radius:4px; cursor:pointer; }
+    canvas { display:block; margin:0 auto; background:#001133; }
+    @media (max-width:360px) {
+      #ui { flex-direction:column; align-items:flex-start; }
+      #restartBtn { margin-top:5px; }
+    }
+  </style>
+</head>
+<body data-ai-factory-game="v2">
+  <div id="ui">
+    <div id="score">점수: 0</div>
+    <button id="restartBtn" onclick="startGame()">다시 시작</button>
+  </div>
+  <canvas id="gameCanvas"></canvas>
+  <div id="msg"></div>
+  <script>
+    // 전역 변수 선언
+    const canvas = document.getElementById('gameCanvas');
+    const ctx = canvas.getContext('2d');
+    const scoreEl = document.getElementById('score');
+    const msgEl = document.getElementById('msg');
+
+    let width, height;
+    const GRAVITY = 0.4;          // 중력 가속도
+    const MAX_ATTEMPTS = 10;      // 최대 시도 횟수
+    const WIN_SCORE = 5;          // 승리 점수
+
+    let star;                     // 현재 스타 객체
+    let target;                   // 목표 영역 객체
+    let isDragging = false;       // 드래그 상태 플래그
+    let dragStart = {x:0, y:0};   // 드래그 시작 좌표
+    let attempts = 0;             // 현재 시도 횟수
+    let score = 0;                // 현재 점수
+
+    // 스타 객체 정의
+    class Star {
+      constructor(x, y) {
+        this.x = x;
+        this.y = y;
+        this.radius = 15;
+        this.vx = 0;
+        this.vy = 0;
+        this.active = false; // 발사 여부
+      }
+      draw() {
+        ctx.beginPath();
+        ctx.arc(this.x, this.y, this.radius, 0, Math.PI*2);
+        ctx.fillStyle = '#00aaff';
+        ctx.fill();
+        ctx.strokeStyle = '#fff';
+        ctx.stroke();
+      }
+      update() {
+        if (!this.active) return;
+        this.vy += GRAVITY;
+        this.x += this.vx;
+        this.y += this.vy;
+        // 바닥 충돌 처리
+        if (this.y + this.radius > height) {
+          this.y = height - this.radius;
+          this.vy *= -0.5; // 반동 감소
+          this.vx *= 0.7;  // 마찰
+          if (Math.abs(this.vy) < 1) {
+            this.active = false;
+            checkLanding();
+          }
+        }
+        // 좌우 벽 충돌 처리
+        if (this.x - this.radius < 0) {
+          this.x = this.radius;
+          this.vx *= -0.5;
+        }
+        if (this.x + this.radius > width) {
+          this.x = width - this.radius;
+          this.vx *= -0.5;
+        }
+      }
+    }
+
+    // 목표 영역 정의
+    class Target {
+      constructor(x, y, w, h) {
+        this.x = x;
+        this.y = y;
+        this.w = w;
+        this.h = h;
+      }
+      draw() {
+        ctx.fillStyle = '#ff4444';
+        ctx.fillRect(this.x, this.y, this.w, this.h);
+        ctx.strokeStyle = '#fff';
+        ctx.strokeRect(this.x, this.y, this.w, this.h);
+      }
+      contains(star) {
+        return (star.x > this.x && star.x < this.x + this.w &&
+                star.y > this.y && star.y < this.y + this.h);
+      }
+    }
+
+    // 게임 초기화 및 시작 함수 (전역 startGame)
+    function startGame() {
+      // 캔버스 크기 설정 (반응형)
+      width = Math.min(window.innerWidth, 800);
+      height = Math.min(window.innerHeight - 80, 600);
+      canvas.width = width;
+      canvas.height = height;
+
+      // 변수 초기화
+      attempts = 0;
+      score = 0;
+      updateScore();
+      msgEl.textContent = '';
+
+      // 스타와 목표 생성
+      resetStar();
+      target = new Target(width - 120, height - 120, 100, 100);
+
+      // 입력 이벤트 바인딩
+      canvas.onmousedown = onPointerDown;
+      canvas.onmousemove = onPointerMove;
+      canvas.onmouseup = onPointerUp;
+      canvas.ontouchstart = e=>{ e.preventDefault(); onPointerDown(e.touches[0]); };
+      canvas.ontouchmove = e=>{ e.preventDefault(); onPointerMove(e.touches[0]); };
+      canvas.ontouchend = e=>{ e.preventDefault(); onPointerUp(e.changedTouches[0]); };
+
+      // 게임 루프 시작
+      requestAnimationFrame(gameLoop);
+    }
+
+    // 스타 재배치 (새 라운드)
+    function resetStar() {
+      star = new Star(80, height - 30);
+    }
+
+    // UI 점수 업데이트
+    function updateScore() {
+      scoreEl.textContent = `점수: ${score}`;
+    }
+
+    // 포인터(마우스/터치) 입력 처리
+    function onPointerDown(e) {
+      const rect = canvas.getBoundingClientRect();
+      const mx = e.clientX - rect.left;
+      const my = e.clientY - rect.top;
+      const dx = mx - star.x;
+      const dy = my - star.y;
+      if (Math.hypot(dx, dy) <= star.radius && !star.active) {
+        isDragging = true;
+        dragStart = {x: mx, y: my};
+      }
+    }
+    function onPointerMove(e) {
+      // 드래그 중 시각화는 draw 단계에서 수행
+    }
+    function onPointerUp(e) {
+      if (!isDragging) return;
+      isDragging = false;
+      const rect = canvas.getBoundingClientRect();
+      const mx = e.clientX - rect.left;
+      const my = e.clientY - rect.top;
+      const dx = dragStart.x - mx;
+      const dy = dragStart.y - my;
+      // 힘 제한 및 방향 계산
+      const power = Math.min(Math.hypot(dx, dy), 150);
+      const angle = Math.atan2(dy, dx);
+      star.vx = Math.cos(angle) * power * 0.07;
+      star.vy = Math.sin(angle) * power * 0.07;
+      star.active = true;
+      attempts++;
+    }
+
+    // 착지 판단 및 점수/게임 종료 로직
+    function checkLanding() {
+      if (target.contains(star)) {
+        score++;
+        msgEl.textContent = '미라클 성공! 🎉';
+        if (score >= WIN_SCORE) {
+          msgEl.textContent = '승리! 별을 모두 모았습니다!';
+          endGame();
+          return;
+        }
+      } else {
+        msgEl.textContent = '미라클 실패...';
+      }
+      updateScore();
+      if (attempts >= MAX_ATTEMPTS) {
+        msgEl.textContent = '시도 횟수 초과! 게임 오버';
+        endGame();
+        return;
+      }
+      // 다음 라운드 준비
+      resetStar();
+    }
+
+    // 게임 종료 시 입력 차단
+    function endGame() {
+      canvas.onmousedown = null;
+      canvas.onmousemove = null;
+      canvas.onmouseup = null;
+      canvas.ontouchstart = null;
+      canvas.ontouchmove = null;
+      canvas.ontouchend = null;
+    }
+
+    // 메인 게임 루프
+    function gameLoop() {
+      ctx.clearRect(0,0,width,height);
+      target.draw();
+      star.update();
+      star.draw();
+      // 드래그 라인 시각화
+      if (isDragging) {
+        ctx.beginPath();
+        ctx.moveTo(star.x, star.y);
+        ctx.lineTo(dragStart.x, dragStart.y);
+        ctx.strokeStyle = '#ffff00';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+      }
+      // 루프 지속 조건
+      if (star.active || (attempts < MAX_ATTEMPTS && score < WIN_SCORE)) {
+        requestAnimationFrame(gameLoop);
+      }
+    }
+
+    // 페이지 로드와 화면 크기 변경 시 자동 시작/재설정
+    window.addEventListener('load', startGame);
+    window.addEventListener('resize', startGame);
+  </script>
+</body>
+</html>
